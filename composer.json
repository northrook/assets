{
  "name": "northrook/assets",
  "description": "An asset generator written in PHP. Creates optimised, public versions of assets from various sources.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Martin",
      "email": "mn@northrook.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Core\\": "src"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "northrook/core": "dev-main",
    "northrook/pathfinder": "dev-main",
    "northrook/minify": "dev-main",
    "northrook/cache": "dev-main",
    "northrook/view": "dev-main",
    "symfony/finder": "^7.2",
    "voku/portable-ascii": "^2.0"
  },
  "require-dev": {
    "symfony/framework-bundle": "@stable",
    "northrook/dev": "dev-main"
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse src"
  }
}
